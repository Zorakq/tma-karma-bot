{
  "name": "tma-karma-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-бот со встроенным Mini App: карма, рейтинг и профили участников чатов",
  "workspaces": [
    "bot",
    "server",
    "webapp"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "dev": "npm run db:push && concurrently -n bot,server,webapp -c blue,green,magenta \"npm:dev:bot\" \"npm:dev:server\" \"npm:dev:webapp\"",
    "dev:bot": "npm run dev -w bot",
    "dev:server": "npm run dev -w server",
    "dev:webapp": "npm run dev -w webapp",
    "build": "npm run build -w webapp && npm run build -w bot && npm run build -w server",
    "start": "concurrently -n bot,server -c blue,green \"npm:start:bot\" \"npm:start:server\"",
    "start:bot": "npm run start -w bot",
    "start:server": "npm run start -w server"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
